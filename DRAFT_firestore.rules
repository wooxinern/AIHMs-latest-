rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- PHASE 3: Primitives & Global Helpers ---
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Relational sync helper: check if request.auth.uid is in the patient's caregiver list
    function isCaregiverOf(patientId) {
      return isSignedIn() && (
        get(/databases/$(database)/documents/users/$(patientId)).data.caregiverIds.hasAny([request.auth.uid]) ||
        get(/databases/$(database)/documents/users/$(patientId)).data.mainCaregiverId == request.auth.uid
      );
    }

    // --- PHASE 2: Validation Blueprints ---

    function isValidUser(data) {
      return data.uid == request.auth.uid
        && data.email is string && data.email.size() <= 256
        && data.role in ['patient', 'caregiver', 'admin']
        && (!('bio' in data) || (data.bio is string && data.bio.size() <= 500))
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100))
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500));
    }

    function isValidHealthLog(data) {
      return data.userId == request.auth.uid || isCaregiverOf(data.userId)
        && data.timestamp is string
        && data.triageZone in ['Red', 'Yellow', 'Green', 'None']
        && (!('weight' in data) || data.weight is number)
        && (!('heartRate' in data) || data.heartRate is number)
        && (!('steps' in data) || data.steps is number)
        && (!('sleepHours' in data) || data.sleepHours is number);
    }

    function isValidAppointment(data) {
      return data.userId is string && (data.userId == request.auth.uid || isCaregiverOf(data.userId))
        && data.title is string && data.title.size() <= 200
        && data.date is string && data.time is string
        && data.status in ['scheduled', 'pending', 'cancelled'];
    }

    function isValidChatMessage(data) {
      return data.role in ['user', 'model']
        && data.text is string && data.text.size() <= 5000
        && data.timestamp is string;
    }

    function isValidPost(data) {
      return data.authorId == request.auth.uid
        && data.title is string && data.title.size() <= 200
        && data.content is string && data.content.size() <= 5000
        && data.type in ['event', 'tip', 'milestone'];
    }

    function isValidCircle(data) {
      return data.name is string && data.name.size() <= 100
        && data.createdBy == request.auth.uid;
    }

    function isValidComment(data) {
      return data.authorId == request.auth.uid
        && data.text is string && data.text.size() <= 1000;
    }

    function isValidFeedback(data) {
      return data.userId == request.auth.uid
        && data.content is string && data.content.size() <= 2000;
    }

    // --- PHASE 4: Collection Patterns ---

    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if false; // Only manageable via manual backend/console
    }

    match /users/{userId} {
      allow get: if isOwner(userId) || isCaregiverOf(userId) || isAdmin();
      allow list: if isAdmin(); // Prevent scraping
      
      allow create: if isOwner(userId) && isValidUser(incoming()) && incoming().role != 'admin'
        && incoming().keys().hasAll(['uid', 'email', 'role', 'hasCompletedOnboarding', 'displayName', 'photoURL'])
        && incoming().keys().size() <= 10;
      allow update: if (isOwner(userId) || isAdmin()) && isValidUser(incoming()) && (
        isAdmin() || (
          // Action: Profile update (cannot change role or ID)
          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'language', 'hasCompletedOnboarding', 'bio', 'bloodType', 'allergies', 'gender', 'houseAddress', 'dob', 'conditions', 'medications', 'icNumber', 'fullName', 'phoneNumber', 'relationship', 'agencyId', 'licenseNumber', 'narrationEnabled', 'updatedAt', 'wearableConnected', 'wearableType', 'wearableToken', 'wearableSyncedAt', 'latestVitals'])
          && incoming().role == existing().role
          && incoming().uid == existing().uid
        ) || (
          // Action: Caregiver Linkage (Tokens restricted)
          incoming().diff(existing()).affectedKeys().hasOnly(['caregiverIds', 'assignedPatientId', 'inviteToken', 'inviteTokenExpiresAt'])
        )
      );
    }

    match /users/{userId}/healthLogs/{logId} {
      allow read: if isOwner(userId) || isCaregiverOf(userId) || isAdmin();
      allow create: if (isOwner(userId) || isCaregiverOf(userId)) && isValidHealthLog(incoming()) && isValidId(logId);
      allow update: if (isOwner(userId) || isCaregiverOf(userId)) && isValidHealthLog(incoming()) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['weight', 'bloodPressure', 'heartRate', 'steps', 'sleepHours', 'mood', 'notes', 'triageZone', 'analysis', 'updatedAt'])
      );
      allow delete: if isOwner(userId) || isAdmin();
    }

    match /users/{userId}/appointments/{apptId} {
      allow read: if isOwner(userId) || isCaregiverOf(userId) || isAdmin();
      allow create: if (isOwner(userId) || isCaregiverOf(userId)) && isValidAppointment(incoming()) && isValidId(apptId);
      allow update: if (isOwner(userId) || isCaregiverOf(userId)) && isValidAppointment(incoming()) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['title', 'date', 'time', 'type', 'notes', 'status', 'reminderEnabled', 'locationName', 'coordinates', 'updatedAt'])
      );
      allow delete: if isOwner(userId) || isCaregiverOf(userId) || isAdmin();
    }

    match /users/{userId}/trustedContacts/{contactId} {
      allow read: if isOwner(userId) || isCaregiverOf(userId) || isAdmin();
      allow create: if isOwner(userId) && isValidId(contactId);
      allow update: if isOwner(userId) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['alertsEnabled', 'reportsEnabled', 'phone', 'email', 'name', 'relation'])
      );
      allow delete: if isOwner(userId);
    }

    match /users/{userId}/chatHistory/{messageId} {
      allow read: if isOwner(userId) || isCaregiverOf(userId) || isAdmin();
      allow create: if (isOwner(userId) || isCaregiverOf(userId)) && isValidChatMessage(incoming()) && isValidId(messageId);
      allow delete: if isOwner(userId) || isAdmin();
    }

    match /users/{userId}/likes/{postId} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId) && isValidId(postId);
    }

    match /users/{userId}/bookmarks/{postId} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId) && isValidId(postId);
    }

    match /users/{userId}/joinedCircles/{circleId} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId) && isValidId(circleId);
    }

    match /users/{userId}/following/{followingId} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId) && isValidId(followingId);
    }

    match /users/{userId}/followers/{followerId} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId) && isValidId(followerId); // Triggered by follow action
    }

    match /communityPosts/{postId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidPost(incoming()) && isValidId(postId);
      allow update: if isSignedIn() && (
        (incoming().authorId == existing().authorId && isValidPost(incoming()) && (
          incoming().diff(existing()).affectedKeys().hasOnly(['title', 'content', 'type', 'location', 'eventDate', 'updatedAt'])
        )) || (
          // System updates (likes, attendees count)
          incoming().diff(existing()).affectedKeys().hasOnly(['likes', 'attendees', 'commentsCount', 'bookmarksCount'])
        )
      );
      allow delete: if (isSignedIn() && existing().authorId == request.auth.uid) || isAdmin();
    }

    match /communityPosts/{postId}/comments/{commentId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidComment(incoming()) && isValidId(commentId);
      allow delete: if (isSignedIn() && existing().authorId == request.auth.uid) || isAdmin();
    }

    match /circles/{circleId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidCircle(incoming()) && isValidId(circleId);
      allow update: if isSignedIn() && (
        (existing().createdBy == request.auth.uid && isValidCircle(incoming()) && (
          incoming().diff(existing()).affectedKeys().hasOnly(['name', 'description', 'icon', 'tasks'])
        )) || (
          // Member count update
          incoming().diff(existing()).affectedKeys().hasOnly(['memberCount'])
        )
      );
      allow delete: if (isSignedIn() && existing().createdBy == request.auth.uid) || isAdmin();
    }

    match /conversations/{conversationId} {
      allow read: if isSignedIn() && (
        conversationId.matches('.*'+request.auth.uid+'.*') || isAdmin()
      );
      allow write: if isSignedIn() && conversationId.matches('.*'+request.auth.uid+'.*');
    }

    match /conversations/{conversationId}/messages/{messageId} {
      allow read: if isSignedIn() && (
        conversationId.matches('.*'+request.auth.uid+'.*') || isAdmin()
      );
      allow create: if isSignedIn() && conversationId.matches('.*'+request.auth.uid+'.*') && isValidId(messageId);
    }

    match /feedback/{feedbackId} {
      allow create: if isSignedIn() && isValidFeedback(incoming()) && isValidId(feedbackId);
      allow read, update, delete: if isAdmin();
    }
  }
}
